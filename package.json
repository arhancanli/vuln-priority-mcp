{
  "name": "vuln-priority-mcp",
  "version": "0.1.0",
  "description": "Ranks CVEs and package vulnerabilities by real-world risk: CISA's Known Exploited Vulnerabilities catalog, FIRST EPSS exploit probability, CVSS, and CISA's SSVC decisions from the CVE record, with the fixed version for each package. No key.",
  "type": "module",
  "license": "MIT",
  "author": { "name": "Arhan Canli", "url": "https://github.com/arhancanli" },
  "bin": { "vuln-priority-mcp": "src/server.mjs" },
  "files": ["src", "README.md", "LICENSE", "npm-shrinkwrap.json"],
  "engines": { "node": ">=20" },
  "scripts": { "test": "node --test test/*.test.mjs", "start": "node src/server.mjs" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.30.1", "zod": "4.6.5" },
  "mcpName": "io.github.arhancanli/vuln-priority-mcp",
  "keywords": ["mcp", "model-context-protocol", "mcp-server", "security"],
  "repository": { "type": "git", "url": "git+https://github.com/arhancanli/vuln-priority-mcp.git" },
  "homepage": "https://github.com/arhancanli/vuln-priority-mcp#readme",
  "bugs": { "url": "https://github.com/arhancanli/vuln-priority-mcp/issues" },
  "factory": { "displayName": "Vuln Priority", "category": "security", "allowHosts": ["www.cisa.gov", "raw.githubusercontent.com", "api.first.org", "cveawg.mitre.org", "api.osv.dev"], "toolListBudget": 6000 }
}
